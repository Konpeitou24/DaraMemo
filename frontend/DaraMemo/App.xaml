<Application x:Class="DaraMemo.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DaraMemo"
             ThemeMode="System">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/PresentationFramework.Fluent;component/Themes/Fluent.xaml" />
            </ResourceDictionary.MergedDictionaries>
            
            <BitmapImage x:Key="BreakIcon" UriSource="pack://application:,,,/Assets/blue.ico"/>
            <BitmapImage x:Key="AfkIcon" UriSource="pack://application:,,,/Assets/red.ico"/>
            <BitmapImage x:Key="ActiveIcon" UriSource="pack://application:,,,/Assets/blue.ico"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
