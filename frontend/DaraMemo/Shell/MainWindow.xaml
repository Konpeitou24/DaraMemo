<Window x:Class="DaraMemo.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DaraMemo"
        mc:Ignorable="d"
        Title="{Binding Title}" d:DesignHeight="450" d:DesignWidth="400">
    <TabControl>
        <TabItem Header="Home">
            <StackPanel>
                <Label Content="Welcome to DaraMemo!" Margin="10"/>
            </StackPanel>
        </TabItem>
    </TabControl>
</Window>
